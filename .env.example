# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=authdb
DB_USER=authuser
DB_PASSWORD=change-me-locally

# JWT (HMAC-SHA256, secret >= 32 bytes)
JWT_SECRET=local-dev-secret-change-me-0123456789
JWT_ACCESS_EXPIRATION=900000      # 15 min (ms)
JWT_REFRESH_EXPIRATION=604800000  # 7 days (ms)

# Admin bootstrap (optional). Leave all empty to disable; to enable, set ALL three.
# ADMIN_USER_ID is the platform-reserved admin id (Decision 10) — use 1.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_USER_ID=
