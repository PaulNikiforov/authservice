# PostgreSQL — app connection
DB_URL=jdbc:postgresql://localhost:5432/authdb
DB_USERNAME=authuser
DB_PASSWORD=change-me-locally

# PostgreSQL — container bootstrap
POSTGRES_DB=authdb
POSTGRES_USER=authuser
POSTGRES_PASSWORD=change-me-locally
DB_PORT=5432

# JWT (RS256). Generate a local-dev pair, e.g.:
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out private.pem
#   openssl pkey -in private.pem -pubout -out public.pem
# Paste each PEM as a multi-line quoted value (supported by Docker Compose's .env parser).
JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----
change-me-generate-a-local-dev-rsa-key-pair
-----END PRIVATE KEY-----"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----
change-me-generate-a-local-dev-rsa-key-pair
-----END PUBLIC KEY-----"
JWT_KEY_ID=local-dev-key-1
JWT_ACCESS_EXPIRATION=900000
JWT_REFRESH_EXPIRATION=604800000

# Admin bootstrap (optional). Leave all empty to disable; to enable, set ALL three.
# ADMIN_USER_ID is the platform-reserved admin id (Decision 10) — use 1.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_USER_ID=

# SonarCloud (local analysis: My Account -> Security)
SONAR_TOKEN=
