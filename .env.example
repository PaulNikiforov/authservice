# PostgreSQL — app connection
DB_URL=jdbc:postgresql://localhost:5432/authdb
DB_USERNAME=authuser
DB_PASSWORD=change-me-locally

# PostgreSQL — container bootstrap
POSTGRES_DB=authdb
POSTGRES_USER=authuser
POSTGRES_PASSWORD=change-me-locally
DB_PORT=5432

# JWT (HMAC-SHA256, secret >= 32 bytes)
JWT_SECRET=local-dev-secret-change-me-0123456789
JWT_ACCESS_EXPIRATION=900000
JWT_REFRESH_EXPIRATION=604800000

# Admin bootstrap (optional). Leave all empty to disable; to enable, set ALL three.
# ADMIN_USER_ID is the platform-reserved admin id (Decision 10) — use 1.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_USER_ID=

# SonarCloud (local analysis: My Account -> Security)
SONAR_TOKEN=
